# Backend Configuration
# Local development
PORT=3001
NODE_ENV=development

# Production (Render uses PORT=10000 by default)
# PORT=10000
# NODE_ENV=production

# Frontend Configuration (Vite uses VITE_ prefix)
# Local development
VITE_WS_URL=ws://localhost:3001/ws

# Production - Set this in Netlify environment variables
# Replace YOUR-RENDER-BACKEND with your actual Render service name
# VITE_WS_URL=wss://YOUR-RENDER-BACKEND.onrender.com/ws
