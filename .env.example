# Backend Configuration
# Local development
PORT=3001
NODE_ENV=development

# Production (Render uses PORT=10000 by default)
# PORT=10000
# NODE_ENV=production

# Frontend Configuration (Vite uses VITE_ prefix)
# Local development
VITE_WS_URL=ws://localhost:3001/ws

# Production (replace with your Render backend URL)
# VITE_WS_URL=wss://ghostnet-backend.onrender.com/ws
